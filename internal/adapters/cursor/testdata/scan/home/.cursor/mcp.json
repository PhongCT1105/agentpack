{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_TOKEN": "ghp_FAKEFAKE",
        "GITHUB_API_URL": "https://api.github.com"
      }
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp",
      "headers": {
        "Authorization": "Bearer FAKE-TOKEN-VALUE"
      }
    },
    "supabase": {
      "type": "sse",
      "url": "https://mcp.supabase.com/sse",
      "headers": {
        "Authorization": "Bearer sbp_FAKEFAKE"
      },
      "auth": {
        "CLIENT_ID": "cursor-FAKE-client",
        "scopes": ["projects:read"]
      }
    }
  }
}
